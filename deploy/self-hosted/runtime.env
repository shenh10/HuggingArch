# The host's runtime configuration that does not depend on the machine: the
# release caches' identity and locations, the artifact source, the Kernel
# Bench restore and the rate limits. One copy, read by the container
# (docker-compose.yml `env_file`), by scripts/release_warm.py (it warms and
# publishes under exactly this environment) and by tests/meta/test_volume_dirs.py.
# Machine sizing is docker-compose.yml's; secrets are the host's env file.
# Plain KEY=value lines only (no quotes, no interpolation).

ANALYZE_RPM=60
INFERENCE_RPM=120

# The trace provider (global | functions). It decides the engine version the
# release artifacts are published under, so warm, publish and this host must
# name the same one (scripts/release.py reads it here). The published
# artifacts are recorded under global; moving to functions is a separate warm.
HA_CODE_TRACE=global
# The code-trace bodies the cached entries name: an entry is served only
# while its trace can be read, so they persist beside the entries.
HA_CODE_TRACE_DIR=/app/.cache/huggingarch/code-traces

# The immutable canonical law pool is machine state, not image state: it lives
# on the volume and is bootstrapped from the versioned Supabase artifact by
# backend.sol_pool_artifact at container start. Empty HA_SOL_POOL_ARTIFACT
# means "read this engine version's index".
HA_SOL_POOL_DIR=/app/.cache/huggingarch/sol-pool
HA_SOL_POOL_ARTIFACT=
HA_ARTIFACT_BUCKET=sol-pool

# Gallery and Scaling sweep caches: on the volume, merged at start from the
# engine's published artifacts and extended by requests.
HA_GALLERY_CACHE_DIR=/app/.cache/huggingarch/gallery-cache
HA_SWEEP_CACHE_DIR=/app/.cache/huggingarch/sweep-cache

# Kernel Bench: on an empty volume, restore the lake from the backup's latest
# snapshot before serving (docs/measured_calibration.md §4.7); with a lake
# already on the volume it does nothing.
HUGGINGARCH_BENCH_RESTORE=on
