# Fill in a copy outside the checkout, then load it into the Docker VM
# (README.md, "Secrets"). Values come from the Fly
# machine: `fly ssh console -C env` (`fly secrets list` shows digests only).

# This host's machine id (lake lease, spec worker). Any stable name.
HA_MACHINE=prod-1
# Cloudflare Zero Trust → Networks → Tunnels → (tunnel) → token
CLOUDFLARE_TUNNEL_TOKEN=
# off while Fly holds the lake's lease; on after the cutover transfer
BENCH_LAKE_LEASE=off
# The deployer's public smoke: the URL this host serves (its tunnel hostname
# until the cutover, then https://www.huggingarch.com).
HA_PUBLIC_URL=
# Read-only GitHub token (fine-grained, public repositories, no permissions):
# lifts the deployer's API quota from 60 to 5000 requests an hour. Optional:
# without it the deployer asks about a pending gate every 2 minutes.
HA_DEPLOY_GITHUB_TOKEN=
# Only when the containers reach the internet through a proxy on the VM's
# gateway: <ipv4>:<port>. The build and the running app and tunnel use it,
# and it is the one private address the egress rules let them reach.
# Unset: no proxy, nothing changes.
HA_EGRESS_PROXY=
# With a proxy: extra comma-separated names to reach directly (containers you
# added to the compose network), beyond localhost and the app's own services.
HA_EGRESS_NO_PROXY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Kernel Bench lake backups (restore reads them; the lease holder writes them)
BENCH_LAKE_BACKUP_DATA=
BENCH_LAKE_BACKUP_S3_ENDPOINT=
BENCH_LAKE_BACKUP_S3_REGION=
BENCH_LAKE_BACKUP_S3_KEY=
BENCH_LAKE_BACKUP_S3_SECRET=

# BYOK credential encryption
HA_CREDS_ENC_KEY=

# GitHub App (spec PRs)
HA_GITHUB_APP_ID=
HA_GITHUB_APP_INSTALLATION_ID=
HA_GITHUB_APP_PRIVATE_KEY=
HA_GITHUB_REPO=

# Copy any other variable `fly ssh console -C env` shows that is not a FLY_*
# variable and not set by the image or docker-compose.yml.
